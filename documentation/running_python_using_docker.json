[
  {
    "System Requirements": "Docker Installed",
    "steps": [
      {
        "Step": 1,
        "Command": "open Docker desktop",
        "Description": "Move to the python services folder"
      },
      {
        "Step": 2,
        "Command": "docker image build -t zipcart-pythonservices .",
        "Description": "building docker image"
      },
      {
        "Step": 3,
        "Command": "docker run -p 5001:5001 zipcart-pythonservices",
        "Description": "run the docker image. Runs at port:5001"
      },
      {
        "Step": 4,
        "Command": "docker ps -a",
        "Description": "lists all the containers in your docker desktop"
      },
      {
        "Step": 5,
        "Command": "docker stop <CONTAINER_ID>",
        "Description": "copy and paste the container Id of zipcart-pythonservices. To stop the running image"
      },
      {
        "Step": 6,
        "command": "docker rm <CONTAINER_ID>",
        "Description": "Removes the image from registry"
      }
    ]
  }
]
